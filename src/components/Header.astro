---
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const onAbout = path === '/about' || path === '/about/';
const onNotes = path === '/' || (path.endsWith('.html') && path !== '/404.html');
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="dkc's notes home">
      <span class="site-brand__mark">dkc</span><span class="site-brand__suffix"> / notes</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/" aria-current={onNotes ? 'page' : undefined}>Notes</a>
      <a href="/about/" aria-current={onAbout ? 'page' : undefined}>About</a>
      <a href="https://github.com/askdkc">GitHub</a>
    </nav>
    <ThemeToggle />
  </div>
</header>
